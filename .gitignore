# API Configuration (contains sensitive keys)
.mcp.json
.env
.env.local
.env.*.local

# macOS
.DS_Store
.AppleDouble
.LSOverride

# Node modules (if using any npm packages)
node_modules/
npm-debug.log*

# Python (if using Python scripts)
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
venv/
env/
ENV/

# Logs
*.log
logs/

# Temporary files
*.tmp
*.temp
.cache/

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# Reports (optional - uncomment if you don't want to commit reports)
# reports/

# Backup files
*.bak
*.backup

# Local video resources (do not track)
/video_resources/

# Video files (ignore all common formats)
# This prevents committing large/binary video assets to the repo.
# Case-insensitive patterns for major types + broad lowercase coverage.
*.[Mm][Pp]4
*.[Mm][Oo][Vv]
*.[Aa][Vv][Ii]
*.[Mm][Kk][Vv]
*.[Mm]4[Vv]
*.[Ww][Ee][Bb][Mm]
*.[Ww][Mm][Vv]
*.flv
*.f4v
*.webm
*.mkv
*.mov
*.mp4
*.m4v
*.avi
*.wmv
*.mpeg
*.mpg
*.mpe
*.3gp
*.3g2
*.ogv
*.ts
*.m2ts
*.mts
*.vob
*.mxf
*.rm
*.rmvb
*.qt
*.dat
