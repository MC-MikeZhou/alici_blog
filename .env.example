# AliciBlog Environment Variables
# Copy this file to .env and fill in your values

# DataForSEO API Credentials
# Sign up at: https://dataforseo.com/
DATAFORSEO_USERNAME=your_email@example.com
DATAFORSEO_PASSWORD=your_api_password

# FAL.ai API Key
# Sign up at: https://fal.ai/
FAL_API_KEY=your_fal_api_key

# Supadata API Key (for YouTube transcripts)
# Sign up at: https://supadata.io/
SUPADATA_API_KEY=your_supadata_api_key

# CDN/Server Configuration
# Replace with your own server details
CDN_SERVER_IP=your_server_ip
CDN_SERVER_USER=your_username
CDN_BASE_URL=https://your-cdn-domain.com/static/image/
